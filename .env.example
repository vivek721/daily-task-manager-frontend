# Copy to .env.local and adjust. Vite only exposes variables prefixed with VITE_,
# and inlines them at build time (rebuild after changing them).

# Backend origin, without the /api suffix. Every API request, the
# "Sign in with Google" redirect and the dev-only test login use it.
# Default: http://localhost:3001
VITE_API_URL=http://localhost:3001
